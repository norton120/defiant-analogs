# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
#
# Generate the API key with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"
ota_password: "REPLACE_WITH_OTA_PASSWORD"

# One distinct key per BMS bank node -- each ESPHome device should have its
# own native API encryption key rather than reusing one across devices.
bank1_api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"
bank2_api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"
bank3_api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# Passwords only -- the SSIDs live inline in defiant-analogs.yaml, since they
# are broadcast over the air and hiding them buys nothing.
wifi_password: "REPLACE_WITH_WIFI_PASSWORD"

# Fallback softAP, broadcast only when the main network is unreachable.
ap_password: "REPLACE_WITH_FALLBACK_AP_PASSWORD"
